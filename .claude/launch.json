{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "edge-kintai-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787"
      ],
      "port": 8787
